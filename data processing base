-- =====================================================================
-- 6. FACULTY-YEAR CORE
--
-- One faculty record per PersonId-year.
-- =====================================================================

CREATE OR REPLACE TABLE
  `foreign-phd.unitanalysis.broker2_faculty_year_core` AS

SELECT

  year,
  PersonId,

  ANY_VALUE(PersonName) AS PersonName,
  ANY_VALUE(author_id) AS author_id,

  ANY_VALUE(InstitutionId) AS InstitutionId,
  ANY_VALUE(InstitutionName) AS InstitutionName,

  ANY_VALUE(DegreeYear) AS DegreeYear,
  ANY_VALUE(DegreeInstitutionName) AS DegreeInstitutionName,
  ANY_VALUE(DegreeInstitutionID) AS DegreeInstitutionID,

  ANY_VALUE(RankTypeId) AS RankTypeId,
  ANY_VALUE(FacultyTitle) AS FacultyTitle,

  ANY_VALUE(Gender) AS Gender,

  ANY_VALUE(degree_country_raw) AS degree_country_raw,
  ANY_VALUE(degree_country) AS degree_country,
  ANY_VALUE(degree_country_code) AS degree_country_code,

  ANY_VALUE(CCIHE_research2025)
    AS CCIHE_research2025,

  ANY_VALUE(CCIHE_research2025name)
    AS CCIHE_research2025name,

  ANY_VALUE(confidence_tier)
    AS confidence_tier,

  MAX(match_score)
    AS match_score,

  MAX(delta_score)
    AS delta_score

FROM
  `foreign-phd.unitanalysis.broker2_faculty_year_full`

GROUP BY
  year,
  PersonId
;


