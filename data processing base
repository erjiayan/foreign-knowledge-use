-- =====================================================================
-- 1. NORMALIZED FACULTY SOURCE
--
-- Preserve raw and normalized country values.
-- =====================================================================

CREATE OR REPLACE TABLE
  `foreign-phd.unitanalysis.broker2_faculty_source` AS

SELECT
  f.*,

  SAFE_CAST(
    SUBSTR(f.AADVersion, 4, 4)
    AS INT64
  ) AS year,

  f.Country AS degree_country_raw,

  COALESCE(
    x.normalized_country,
    f.Country
  ) AS degree_country,

  x.country_code AS degree_country_code

FROM
  `foreign-phd.unitanalysis.facultyraw_enriched` f

LEFT JOIN
  `foreign-phd.unitanalysis.broker2_country_crosswalk` x

ON
  f.Country = x.raw_country

WHERE
  SAFE_CAST(
    SUBSTR(f.AADVersion, 4, 4)
    AS INT64
  ) BETWEEN 2011 AND 2020

  AND f.author_id IS NOT NULL
  AND f.confidence_tier IN ('High', 'Medium')
  AND f.Country IS NOT NULL
;


-- =====================================================================
-- 2. COUNTRY NORMALIZATION AUDIT
--
-- Inspect any unmapped country values before proceeding.
-- =====================================================================

SELECT
  degree_country_raw,
  degree_country,
  degree_country_code,
  COUNT(DISTINCT PersonId) AS n_faculty

FROM
  `foreign-phd.unitanalysis.broker2_faculty_source`

GROUP BY
  degree_country_raw,
  degree_country,
  degree_country_code

ORDER BY
  n_faculty DESC
;


-- =====================================================================
-- 3. TOP 50 NORMALIZED FOREIGN DEGREE COUNTRIES
--
-- IMPORTANT:
-- Korea and South Korea become one category here.
--
-- USSR remains rankable descriptively, but because its country_code
-- is NULL it cannot enter same-current-country citation analysis.
-- =====================================================================

CREATE OR REPLACE TABLE
  `foreign-phd.unitanalysis.broker2_top50_degree_countries` AS

WITH counts AS (

  SELECT
    degree_country,
    degree_country_code,
    COUNT(DISTINCT PersonId) AS n_faculty

  FROM
    `foreign-phd.unitanalysis.broker2_faculty_source`

  WHERE
    degree_country != 'United States'

  GROUP BY
    degree_country,
    degree_country_code
),

ranked AS (

  SELECT
    *,
    ROW_NUMBER() OVER (
      ORDER BY n_faculty DESC, degree_country
    ) AS degree_country_rank

  FROM counts
)

SELECT *
FROM ranked
WHERE degree_country_rank <= 50
;


-- =====================================================================
-- 4. ANALYZABLE TARGET COUNTRIES
--
-- Same-country knowledge alignment requires a current OpenAlex
-- country code.
--
-- USSR therefore remains in the descriptive training geography
-- but does not enter this target-country table.
-- =====================================================================

CREATE OR REPLACE TABLE
  `foreign-phd.unitanalysis.broker2_target_countries` AS

SELECT
  degree_country,
  degree_country_code AS country_code,
  n_faculty,
  degree_country_rank

FROM
  `foreign-phd.unitanalysis.broker2_top50_degree_countries`

WHERE
  degree_country_code IS NOT NULL
;


