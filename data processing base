  w.publication_year AS cited_year,
  w.publication_date AS cited_date,

  w.doi AS cited_doi,
  w.language AS cited_language,

  w.authors_count
    AS cited_authors_count,

  ARRAY_LENGTH(w.authorships)
    AS cited_authorship_records,

  SAFE_DIVIDE(
    ARRAY_LENGTH(w.authorships),
    w.authors_count
  ) AS cited_authorship_record_coverage,

  w.authorships_truncated
    AS cited_authorships_truncated,

  w.countries_distinct_count
    AS cited_countries_distinct_count,

  w.institutions_distinct_count
    AS cited_institutions_distinct_count,

  w.cited_by_count,

  w.fwci
    AS cited_fwci,

  w.citation_normalized_percentile.value
    AS cited_percentile,

  w.primary_topic.id
    AS cited_topic_id,

  w.primary_topic.display_name
    AS cited_topic_name,

  w.primary_topic.subfield.id
    AS cited_subfield_id,

  w.primary_topic.subfield.display_name
    AS cited_subfield_name,

  w.primary_topic.field.id
    AS cited_field_id,

  w.primary_topic.field.display_name
    AS cited_field_name,

  w.primary_topic.domain.id
    AS cited_domain_id,

  w.primary_topic.domain.display_name
    AS cited_domain_name,

  w.primary_location.source.id
    AS cited_source_id,

  w.primary_location.source.display_name
    AS cited_source_name

FROM
  `subugoe-collaborative.openalex_walden.works` w

JOIN ids
ON
  w.id = ids.cited_work_id
;


-- =====================================================================
-- 15. CITED-WORK AUTHOR COUNTRY DATA
-- =====================================================================

CREATE OR REPLACE TABLE
  `foreign-phd.unitanalysis.broker2_cited_author_country` AS

SELECT DISTINCT

  w.id AS cited_work_id,

  a.author.id AS author_id,

  country_code

FROM
  `subugoe-collaborative.openalex_walden.works` w

JOIN
  `foreign-phd.unitanalysis.broker2_cited_work_master` cm

ON
  w.id = cm.cited_work_id

CROSS JOIN
  UNNEST(w.authorships) a

CROSS JOIN
  UNNEST(a.countries) country_code

WHERE
  a.author.id IS NOT NULL
  AND country_code IS NOT NULL
  AND country_code != ''
;


-- =====================================================================
-- 16. CITED WORK COUNTRY COVERAGE
-- =====================================================================

CREATE OR REPLACE TABLE
  `foreign-phd.unitanalysis.broker2_cited_country_coverage` AS

WITH mapped AS (

  SELECT

    cited_work_id,

    COUNT(DISTINCT author_id)
      AS n_authors_with_country

  FROM
    `foreign-phd.unitanalysis.broker2_cited_author_country`

  GROUP BY
    cited_work_id
)

SELECT

  cm.cited_work_id,

  cm.cited_authors_count,
  cm.cited_authorship_records,

  COALESCE(m.n_authors_with_country, 0)
    AS n_authors_with_country,

  SAFE_DIVIDE(
    COALESCE(m.n_authors_with_country, 0),
    cm.cited_authors_count
  ) AS cited_country_coverage_reported,

  SAFE_DIVIDE(
    COALESCE(m.n_authors_with_country, 0),
    cm.cited_authorship_records
  ) AS cited_country_coverage_observed,

  cm.cited_authorship_record_coverage,

  cm.cited_authorships_truncated,

  CASE
    WHEN COALESCE(m.n_authors_with_country, 0) = 0
    THEN 1 ELSE 0
  END AS no_author_country_data

FROM
  `foreign-phd.unitanalysis.broker2_cited_work_master` cm

LEFT JOIN mapped m
USING (cited_work_id)
;


-- =====================================================================
-- 17. AUTHOR-FRACTIONAL CITED-WORK COUNTRY WEIGHTS
--
-- Each mapped author gets equal weight.
-- A multi-country author's weight is split across their countries.
--
-- We normalize among authors for whom country data are available.
-- Completeness is retained separately in coverage variables.
-- =====================================================================

CREATE OR REPLACE TABLE
  `foreign-phd.unitanalysis.broker2_cited_work_country` AS

WITH author_ncountries AS (

  SELECT

    cited_work_id,
    author_id,

    COUNT(DISTINCT country_code)
      AS n_author_countries

  FROM
    `foreign-phd.unitanalysis.broker2_cited_author_country`

  GROUP BY
    cited_work_id,
    author_id
),

work_nauthors AS (

  SELECT

    cited_work_id,

    COUNT(DISTINCT author_id)
      AS n_mapped_authors

  FROM
    `foreign-phd.unitanalysis.broker2_cited_author_country`

  GROUP BY
    cited_work_id
),

fractional AS (

  SELECT

    ac.cited_work_id,
    ac.author_id,
    ac.country_code,

    SAFE_DIVIDE(
      1.0,
      wa.n_mapped_authors * nc.n_author_countries
    ) AS contribution

  FROM
    `foreign-phd.unitanalysis.broker2_cited_author_country` ac

  JOIN author_ncountries nc
  USING (cited_work_id, author_id)

  JOIN work_nauthors wa
  USING (cited_work_id)
),

country_sum AS (

  SELECT

    cited_work_id,
    country_code,

    SUM(contribution)
      AS country_weight

  FROM fractional

  GROUP BY
    cited_work_id,
    country_code
),

work_flags AS (

  SELECT

    cited_work_id,

    MAX(CASE
      WHEN country_code = 'US'
      THEN 1 ELSE 0
    END) AS has_us_country,

    COUNT(*)
      AS n_mapped_countries

  FROM country_sum

  GROUP BY cited_work_id
)

SELECT

  cs.cited_work_id,

  cs.country_code,

  cs.country_weight,

  wf.has_us_country,

  wf.n_mapped_countries,

  CASE
    WHEN cs.country_weight > 0
    THEN 1 ELSE 0
  END AS any_country_presence,

  CASE
    WHEN cs.country_weight >= 0.25
    THEN 1 ELSE 0
  END AS country_presence_25,

  CASE
    WHEN cs.country_weight > 0.50
    THEN 1 ELSE 0
  END AS country_majority,

  CASE
    WHEN ABS(cs.country_weight - 1.0) < 0.000001
    THEN 1 ELSE 0
  END AS country_exclusive,

  CASE
    WHEN wf.n_mapped_countries = 1
    THEN 1 ELSE 0
  END AS single_country_work

FROM
  country_sum cs

JOIN
  work_flags wf
USING (cited_work_id)
;


-- =====================================================================
-- 18. CITING AUTHORS FOR SELF-CITATION DETECTION
-- =====================================================================

CREATE OR REPLACE TABLE
  `foreign-phd.unitanalysis.broker2_citing_authors` AS

SELECT DISTINCT

  w.id AS citing_work_id,

  a.author.id AS author_id

FROM
  `subugoe-collaborative.openalex_walden.works` w

JOIN
  `foreign-phd.unitanalysis.broker2_focal_papers` fp

ON
  w.id = fp.work_id

CROSS JOIN
  UNNEST(w.authorships) a

WHERE
  a.author.id IS NOT NULL
  AND a.author.id != ''
;


-- =====================================================================
-- 19. CITED AUTHORS FOR SELF-CITATION DETECTION
-- =====================================================================

CREATE OR REPLACE TABLE
  `foreign-phd.unitanalysis.broker2_cited_authors` AS

SELECT DISTINCT

  w.id AS cited_work_id,

  a.author.id AS author_id

FROM
  `subugoe-collaborative.openalex_walden.works` w

JOIN
  `foreign-phd.unitanalysis.broker2_cited_work_master` cm

ON
  w.id = cm.cited_work_id

CROSS JOIN
  UNNEST(w.authorships) a

WHERE
  a.author.id IS NOT NULL
  AND a.author.id != ''
;


-- =====================================================================
-- 20. TEAM SELF-CITATION
--
-- Any author overlaps between citing and cited paper.
-- =====================================================================

CREATE OR REPLACE TABLE
  `foreign-phd.unitanalysis.broker2_team_selfcite_edges` AS

SELECT DISTINCT

  e.citing_work_id,
  e.cited_work_id

FROM
  `foreign-phd.unitanalysis.broker2_citation_edges_base` e

JOIN
  `foreign-phd.unitanalysis.broker2_citing_authors` ca

ON
  e.citing_work_id = ca.citing_work_id

JOIN
  `foreign-phd.unitanalysis.broker2_cited_authors` da

ON
  e.cited_work_id = da.cited_work_id
  AND ca.author_id = da.author_id
;


-- =====================================================================
-- 21. AARC-FOCAL SELF-CITATION
--
-- AARC faculty on citing paper also authored cited paper.
-- =====================================================================

CREATE OR REPLACE TABLE
  `foreign-phd.unitanalysis.broker2_aarc_selfcite_edges` AS

SELECT DISTINCT

  e.citing_work_id,
  e.cited_work_id

FROM
  `foreign-phd.unitanalysis.broker2_citation_edges_base` e

JOIN
  `foreign-phd.unitanalysis.broker2_aarc_paper_authors` ap

ON
  e.citing_work_id = ap.work_id

JOIN
  `foreign-phd.unitanalysis.broker2_cited_authors` da

ON
  e.cited_work_id = da.cited_work_id
  AND ap.author_id = da.author_id
;


-- =====================================================================
-- 22. ENRICHED CITATION EDGES
-- =====================================================================

CREATE OR REPLACE TABLE
  `foreign-phd.unitanalysis.broker2_citation_edges` AS

SELECT

  e.citing_work_id,
  e.citing_year,
  e.cited_work_id,

  cm.cited_year,

  e.citing_year - cm.cited_year
    AS cited_work_age,

  cm.cited_authors_count,
  cm.cited_authorship_records,
  cm.cited_authorship_record_coverage,
  cm.cited_authorships_truncated,

  cm.cited_countries_distinct_count,
  cm.cited_institutions_distinct_count,

  cm.cited_by_count,
  cm.cited_fwci,
  cm.cited_percentile,

  cm.cited_topic_id,
  cm.cited_subfield_id,
  cm.cited_field_id,
  cm.cited_domain_id,
  cm.cited_source_id,

  cov.cited_country_coverage_reported,
  cov.cited_country_coverage_observed,

  CASE
    WHEN ts.cited_work_id IS NOT NULL
    THEN 1 ELSE 0
  END AS team_self_citation,

  CASE
    WHEN ars.cited_work_id IS NOT NULL
    THEN 1 ELSE 0
  END AS aarc_self_citation

FROM
  `foreign-phd.unitanalysis.broker2_citation_edges_base` e

LEFT JOIN
  `foreign-phd.unitanalysis.broker2_cited_work_master` cm

ON
  e.cited_work_id = cm.cited_work_id

LEFT JOIN
  `foreign-phd.unitanalysis.broker2_cited_country_coverage` cov

ON
  e.cited_work_id = cov.cited_work_id

LEFT JOIN
  `foreign-phd.unitanalysis.broker2_team_selfcite_edges` ts

ON
  e.citing_work_id = ts.citing_work_id
  AND e.cited_work_id = ts.cited_work_id

LEFT JOIN
  `foreign-phd.unitanalysis.broker2_aarc_selfcite_edges` ars

ON
  e.citing_work_id = ars.citing_work_id
  AND e.cited_work_id = ars.cited_work_id
;


-- =====================================================================
-- 23. PAPER x TARGET DEGREE COUNTRY EXPOSURE
--
-- This cross-join occurs only at the PAPER level, not citation level.
-- =====================================================================

CREATE OR REPLACE TABLE
  `foreign-phd.unitanalysis.broker2_paper_country_exposure50` AS

SELECT

  fp.work_id,
  fp.publication_year,

  tc.degree_country,
  tc.country_code,

  tc.n_faculty AS degree_country_faculty_n,

  tc.degree_country_rank,

  COUNT(DISTINCT CASE
    WHEN ap.degree_country = tc.degree_country
    THEN ap.PersonId
  END) AS n_matching_degree_aarc,

  CASE
    WHEN COUNT(DISTINCT CASE
      WHEN ap.degree_country = tc.degree_country
      THEN ap.PersonId
    END) > 0
    THEN 1 ELSE 0
  END AS has_matching_degree_author,

  MAX(CASE
    WHEN ap.degree_country = tc.degree_country
         AND ap.is_corresponding
    THEN 1 ELSE 0
  END) AS matching_degree_corresponding,

  MAX(CASE
    WHEN ap.degree_country = tc.degree_country
         AND ap.author_position = 'first'
    THEN 1 ELSE 0
  END) AS matching_degree_first_author,

  MAX(CASE
    WHEN ap.degree_country = tc.degree_country
         AND ap.author_position = 'last'
    THEN 1 ELSE 0
  END) AS matching_degree_last_author

FROM
  `foreign-phd.unitanalysis.broker2_focal_papers` fp

CROSS JOIN
  `foreign-phd.unitanalysis.broker2_target_countries` tc

LEFT JOIN
  `foreign-phd.unitanalysis.broker2_aarc_paper_authors` ap

ON
  fp.work_id = ap.work_id

GROUP BY

  fp.work_id,
  fp.publication_year,

  tc.degree_country,
  tc.country_code,

  tc.n_faculty,
  tc.degree_country_rank
;


-- =====================================================================
-- 24. CURRENT TARGET-COUNTRY COLLABORATION
--
-- Distinguishes training imprint from active international collaboration.
-- =====================================================================

CREATE OR REPLACE TABLE
  `foreign-phd.unitanalysis.broker2_current_country_exposure50` AS

SELECT

  pc.work_id,
  pc.degree_country,
  pc.country_code,

  MAX(CASE
    WHEN cac.country_code = pc.country_code
    THEN 1 ELSE 0
  END) AS any_current_target_country,

  MAX(CASE
    WHEN cac.country_code = pc.country_code
         AND cac.is_aarc_author = 0
    THEN 1 ELSE 0
  END) AS nonaarc_current_target_country,

  MAX(CASE
    WHEN cac.country_code = pc.country_code

         AND NOT (
           cac.is_aarc_author = 1
           AND cac.aarc_degree_country = pc.degree_country
         )

    THEN 1 ELSE 0
  END) AS other_coauthor_current_target_country,

  MAX(CASE
    WHEN cac.country_code = pc.country_code
         AND cac.is_corresponding
    THEN 1 ELSE 0
  END) AS corresponding_current_target_country

FROM
  `foreign-phd.unitanalysis.broker2_paper_country_exposure50` pc

LEFT JOIN
  `foreign-phd.unitanalysis.broker2_citing_author_countries` cac

ON
  pc.work_id = cac.work_id

GROUP BY
  pc.work_id,
  pc.degree_country,
  pc.country_code
;


-- =====================================================================
-- 25. PAPER x CITED COUNTRY AGGREGATION
--
-- Still all countries, not merely the top 50.
--
-- This is valuable for the later 50x50 placebo matrix.
-- =====================================================================

CREATE OR REPLACE TABLE
  `foreign-phd.unitanalysis.broker2_paper_cited_country` AS

SELECT

  e.citing_work_id AS work_id,

  cw.country_code AS cited_country_code,


  -- Fractional provenance
  SUM(cw.country_weight)
    AS country_mass,


  -- Alternative country definitions
  SUM(cw.any_country_presence)
    AS country_any_count,

  SUM(cw.country_presence_25)
    AS country_25_count,

  SUM(cw.country_majority)
    AS country_majority_count,

  SUM(cw.country_exclusive)
    AS country_exclusive_count,


  -- Non-U.S.-co-produced cited works
  SUM(CASE
    WHEN cw.has_us_country = 0
    THEN cw.country_weight
    ELSE 0
  END) AS country_mass_nonus,


  -- Team self-citations excluded
  SUM(CASE
    WHEN e.team_self_citation = 0
    THEN cw.country_weight
    ELSE 0
  END) AS country_mass_no_team_self,


  -- AARC focal self-citations excluded
  SUM(CASE
    WHEN e.aarc_self_citation = 0
    THEN cw.country_weight
    ELSE 0
  END) AS country_mass_no_aarc_self,


  -- No-US AND team-self excluded simultaneously
  SUM(CASE
    WHEN cw.has_us_country = 0
         AND e.team_self_citation = 0
    THEN cw.country_weight
    ELSE 0
  END) AS country_mass_nonus_no_team_self,


  -- High country coverage
  SUM(CASE
    WHEN e.cited_country_coverage_observed >= 0.80
    THEN cw.country_weight
    ELSE 0
  END) AS country_mass_cov80,


  SUM(CASE
    WHEN e.cited_country_coverage_observed >= 0.95
    THEN cw.country_weight
    ELSE 0
  END) AS country_mass_cov95

FROM
  `foreign-phd.unitanalysis.broker2_citation_edges` e

JOIN
  `foreign-phd.unitanalysis.broker2_cited_work_country` cw

ON
  e.cited_work_id = cw.cited_work_id

GROUP BY
  work_id,
  cited_country_code
;


-- =====================================================================
-- 26. PAPER REFERENCE DENOMINATORS
--
-- Denominators corresponding to the alternative numerators above.
-- =====================================================================

CREATE OR REPLACE TABLE
  `foreign-phd.unitanalysis.broker2_paper_reference_summary` AS

SELECT

  e.citing_work_id AS work_id,

  COUNT(*) AS n_reference_edges,


  -- References for which at least some country data exist
  COUNTIF(
    e.cited_country_coverage_observed > 0
  ) AS n_refs_with_country,


  SAFE_DIVIDE(
    COUNTIF(e.cited_country_coverage_observed > 0),
    COUNT(*)
  ) AS reference_country_coverage,


  -- No-US reference denominator
  COUNTIF(
    e.cited_country_coverage_observed > 0
    AND NOT EXISTS (
      SELECT 1
      FROM
        `foreign-phd.unitanalysis.broker2_cited_work_country` cw2
      WHERE
        cw2.cited_work_id = e.cited_work_id
        AND cw2.country_code = 'US'
    )
  ) AS n_refs_nonus,


  -- Self-citation counts
  COUNTIF(
    e.team_self_citation = 1
  ) AS n_team_selfcitations,

  COUNTIF(
    e.aarc_self_citation = 1
  ) AS n_aarc_selfcitations,


  -- Valid-reference denominators after self-citation removal
  COUNTIF(
    e.team_self_citation = 0
    AND e.cited_country_coverage_observed > 0
  ) AS n_refs_country_no_team_self,

  COUNTIF(
    e.aarc_self_citation = 0
    AND e.cited_country_coverage_observed > 0
  ) AS n_refs_country_no_aarc_self,


  -- No-US plus no-team-self denominator
  COUNTIF(
    e.team_self_citation = 0
    AND e.cited_country_coverage_observed > 0
    AND NOT EXISTS (
      SELECT 1
      FROM
        `foreign-phd.unitanalysis.broker2_cited_work_country` cw3
      WHERE
        cw3.cited_work_id = e.cited_work_id
        AND cw3.country_code = 'US'
    )
  ) AS n_refs_nonus_no_team_self,


  -- High-completeness denominators
  COUNTIF(
    e.cited_country_coverage_observed >= 0.80
  ) AS n_refs_cov80,

  COUNTIF(
    e.cited_country_coverage_observed >= 0.95
  ) AS n_refs_cov95,


  -- Reference-list characteristics
  AVG(e.cited_work_age)
    AS mean_reference_age,

  AVG(e.cited_fwci)
    AS mean_cited_fwci,

  AVG(e.cited_by_count)
    AS mean_cited_global_citations

FROM
  `foreign-phd.unitanalysis.broker2_citation_edges` e

GROUP BY
  work_id
;


-- =====================================================================
-- 27. FINAL PAPER x TARGET COUNTRY MASTER TABLE
-- =====================================================================

CREATE OR REPLACE TABLE
  `foreign-phd.unitanalysis.broker2_paper_country50` AS

SELECT

  pc.work_id,

  fp.publication_year,

  pc.degree_country
    AS target_degree_country,

  pc.country_code
    AS target_country_code,

  pc.degree_country_rank,
  pc.degree_country_faculty_n,


  -- =========================================================
  -- DEGREE-COUNTRY EXPOSURE
  -- =========================================================

  pc.has_matching_degree_author,
  pc.n_matching_degree_aarc,

  pc.matching_degree_corresponding,
  pc.matching_degree_first_author,
  pc.matching_degree_last_author,


  -- =========================================================
  -- CURRENT INTERNATIONAL COLLABORATION
  -- =========================================================

  COALESCE(cur.any_current_target_country, 0)
    AS any_current_target_country,

  COALESCE(cur.nonaarc_current_target_country, 0)
    AS nonaarc_current_target_country,

  COALESCE(cur.other_coauthor_current_target_country, 0)
    AS other_coauthor_current_target_country,

  COALESCE(cur.corresponding_current_target_country, 0)
    AS corresponding_current_target_country,


  -- =========================================================
  -- CITING-PAPER TEAM
  -- =========================================================

  fp.authors_count,
  fp.oa_authorship_records,
  fp.authorship_record_coverage,

  -- Diagnostic only
  fp.authorships_truncated,

  fp.n_aarc_faculty,
  fp.n_aarc_us_degree,
  fp.n_aarc_foreign_degree,

  fp.n_aarc_degree_countries,
  fp.n_foreign_degree_countries,

  cs.n_authors_with_country
    AS citing_n_authors_with_country,

  cs.citing_country_coverage_reported,
  cs.citing_country_coverage_observed,

  cs.n_current_countries,

  cs.has_us_current_affiliation,
  cs.has_nonus_current_affiliation,

  cs.current_team_us_only,


  -- =========================================================
  -- REFERENCE COVERAGE
  -- =========================================================

  rs.n_reference_edges,

  rs.n_refs_with_country,

  rs.reference_country_coverage,

  rs.n_refs_nonus,

  rs.n_team_selfcitations,
  rs.n_aarc_selfcitations,

  SAFE_DIVIDE(
    rs.n_team_selfcitations,
    rs.n_reference_edges
  ) AS team_selfcitation_share,

  SAFE_DIVIDE(
    rs.n_aarc_selfcitations,
    rs.n_reference_edges
  ) AS aarc_selfcitation_share,


  -- =========================================================
  -- TARGET-COUNTRY FRACTIONAL MASSES
  -- =========================================================

  COALESCE(cc.country_mass, 0)
    AS target_country_mass,

  COALESCE(cc.country_mass_nonus, 0)
    AS target_country_mass_nonus,

  COALESCE(cc.country_mass_no_team_self, 0)
    AS target_country_mass_no_team_self,

  COALESCE(cc.country_mass_no_aarc_self, 0)
    AS target_country_mass_no_aarc_self,

  COALESCE(cc.country_mass_nonus_no_team_self, 0)
    AS target_country_mass_nonus_no_team_self,

  COALESCE(cc.country_mass_cov80, 0)
    AS target_country_mass_cov80,

  COALESCE(cc.country_mass_cov95, 0)
    AS target_country_mass_cov95,


  -- =========================================================
  -- ALTERNATIVE COUNTRY PROVENANCE DEFINITIONS
  -- =========================================================

  COALESCE(cc.country_any_count, 0)
    AS target_country_any_count,

  COALESCE(cc.country_25_count, 0)
    AS target_country_25_count,

  COALESCE(cc.country_majority_count, 0)
    AS target_country_majority_count,

  COALESCE(cc.country_exclusive_count, 0)
    AS target_country_exclusive_count,


  -- =========================================================
  -- PRIMARY SHARES
  -- =========================================================

  SAFE_DIVIDE(
    COALESCE(cc.country_mass, 0),
    rs.n_refs_with_country
  ) AS target_country_share,


  -- Target-country knowledge produced on cited papers with no US
  -- participation, relative to all country-mapped references.
  SAFE_DIVIDE(
    COALESCE(cc.country_mass_nonus, 0),
    rs.n_refs_with_country
  ) AS target_country_nonus_share_allrefs,


  -- Conditional composition among non-US references.
  SAFE_DIVIDE(
    COALESCE(cc.country_mass_nonus, 0),
    rs.n_refs_nonus
  ) AS target_country_share_among_nonus_refs,


  -- Stringent team self-citation exclusion.
  SAFE_DIVIDE(
    COALESCE(cc.country_mass_no_team_self, 0),
    rs.n_refs_country_no_team_self
  ) AS target_country_share_no_team_self,


  -- Narrower AARC-faculty self-citation exclusion.
  SAFE_DIVIDE(
    COALESCE(cc.country_mass_no_aarc_self, 0),
    rs.n_refs_country_no_aarc_self
  ) AS target_country_share_no_aarc_self,


  -- Simultaneously no-US and no team self-citation.
  SAFE_DIVIDE(
    COALESCE(cc.country_mass_nonus_no_team_self, 0),
    rs.n_refs_country_no_team_self
  ) AS target_country_nonus_share_no_team_self_allrefs,


  SAFE_DIVIDE(
    COALESCE(cc.country_mass_nonus_no_team_self, 0),
    rs.n_refs_nonus_no_team_self
  ) AS target_country_share_among_nonus_no_team_self,


  -- High country-metadata completeness.
  SAFE_DIVIDE(
    COALESCE(cc.country_mass_cov80, 0),
    rs.n_refs_cov80
  ) AS target_country_share_cov80,

  SAFE_DIVIDE(
    COALESCE(cc.country_mass_cov95, 0),
    rs.n_refs_cov95
  ) AS target_country_share_cov95,


  -- Alternative binary-ish provenance definitions.
  SAFE_DIVIDE(
    COALESCE(cc.country_any_count, 0),
    rs.n_refs_with_country
  ) AS target_country_any_share,

  SAFE_DIVIDE(
    COALESCE(cc.country_25_count, 0),
    rs.n_refs_with_country
  ) AS target_country_25_share,

  SAFE_DIVIDE(
    COALESCE(cc.country_majority_count, 0),
    rs.n_refs_with_country
  ) AS target_country_majority_share,

  SAFE_DIVIDE(
    COALESCE(cc.country_exclusive_count, 0),
    rs.n_refs_with_country
  ) AS target_country_exclusive_share,


  -- =========================================================
  -- INTELLECTUAL CONTROLS
  -- =========================================================

  fp.topic_id,
  fp.topic_name,

  fp.subfield_id,
  fp.subfield_name,

  fp.field_id,
  fp.field_name,

  fp.domain_id,
  fp.domain_name,

  fp.source_id,
  fp.source_name,

  fp.language,


  -- =========================================================
  -- PAPER IMPACT
  -- =========================================================

  fp.fwci,
  fp.citation_percentile,
  fp.is_top1,
  fp.is_top10,


  -- =========================================================
  -- CHARACTERISTICS OF CITED KNOWLEDGE
  -- =========================================================

  rs.mean_reference_age,
  rs.mean_cited_fwci,
  rs.mean_cited_global_citations

FROM
  `foreign-phd.unitanalysis.broker2_paper_country_exposure50` pc

JOIN
  `foreign-phd.unitanalysis.broker2_focal_papers` fp

ON
  pc.work_id = fp.work_id

LEFT JOIN
  `foreign-phd.unitanalysis.broker2_current_country_exposure50` cur

ON
  pc.work_id = cur.work_id
  AND pc.degree_country = cur.degree_country

LEFT JOIN
  `foreign-phd.unitanalysis.broker2_citing_country_summary` cs

ON
  pc.work_id = cs.work_id

LEFT JOIN
  `foreign-phd.unitanalysis.broker2_paper_reference_summary` rs

ON
  pc.work_id = rs.work_id

LEFT JOIN
  `foreign-phd.unitanalysis.broker2_paper_cited_country` cc

ON
  pc.work_id = cc.work_id
  AND pc.country_code = cc.cited_country_code
;


-- =====================================================================
-- 28. ORGANIZATIONAL CONTEXT
--
-- Kept separately to avoid blowing up paper-country table.
-- =====================================================================

CREATE OR REPLACE TABLE
  `foreign-phd.unitanalysis.broker2_paper_organizational_context` AS

SELECT DISTINCT

  ap.work_id,

  u.PersonId,
  u.author_id,

  u.InstitutionId,
  u.InstitutionName,

  u.UnitId,
  u.UnitName,

  u.TaxonomyLevel01Id,
  u.TaxonomyLevel01Name,

  u.Umbrella,
  u.Area,

  u.degree_country,
  u.degree_country_code

FROM
  `foreign-phd.unitanalysis.broker2_aarc_paper_authors` ap

JOIN
  `foreign-phd.unitanalysis.broker2_faculty_year_units` u

ON
  ap.PersonId = u.PersonId
  AND ap.publication_year = u.year
;


-- =====================================================================
-- 29. VALIDATION: TARGET COUNTRIES
-- =====================================================================

SELECT
  degree_country_rank,
  degree_country,
  degree_country_code,
  n_faculty

FROM
  `foreign-phd.unitanalysis.broker2_top50_degree_countries`

ORDER BY
  degree_country_rank
;


-- =====================================================================
-- 30. VALIDATION: COUNTRY-WEIGHT SUMS
--
-- Should be essentially 1 for every cited work with mapped countries.
-- =====================================================================

SELECT

  APPROX_QUANTILES(
    total_weight,
    20
  ) AS country_weight_quantiles

FROM (

  SELECT
    cited_work_id,
    SUM(country_weight) AS total_weight

  FROM
    `foreign-phd.unitanalysis.broker2_cited_work_country`

  GROUP BY
    cited_work_id
)
;


-- =====================================================================
-- 31. VALIDATION: SELF-CITATION MUST BE NONZERO
-- =====================================================================

SELECT

  COUNT(*) AS citation_edges,

  COUNTIF(team_self_citation = 1)
    AS team_selfcitation_edges,

  SAFE_DIVIDE(
    COUNTIF(team_self_citation = 1),
    COUNT(*)
  ) AS team_selfcitation_rate,

  COUNTIF(aarc_self_citation = 1)
    AS aarc_selfcitation_edges,

  SAFE_DIVIDE(
    COUNTIF(aarc_self_citation = 1),
    COUNT(*)
  ) AS aarc_selfcitation_rate

FROM
  `foreign-phd.unitanalysis.broker2_citation_edges`
;


-- =====================================================================
-- 32. VALIDATION: EMPIRICAL AUTHORSHIP COMPLETENESS
-- =====================================================================

SELECT

  APPROX_QUANTILES(
    cited_authorship_record_coverage,
    20
  ) AS authorship_record_coverage_quantiles,

  APPROX_QUANTILES(
    cited_country_coverage_observed,
    20
  ) AS country_coverage_observed_quantiles,

  APPROX_QUANTILES(
    cited_country_coverage_reported,
    20
  ) AS country_coverage_reported_quantiles

FROM
  `foreign-phd.unitanalysis.broker2_citation_edges`
;


-- =====================================================================
-- 33. VALIDATION: WHAT DOES authorships_truncated ACTUALLY CONTAIN?
--
-- Diagnostic only.
-- =====================================================================

SELECT

  CAST(cited_authorships_truncated AS STRING)
    AS authorships_truncated_value,

  COUNT(DISTINCT cited_work_id)
    AS n_cited_works,

  AVG(cited_authorship_record_coverage)
    AS mean_record_coverage

FROM
  `foreign-phd.unitanalysis.broker2_citation_edges`

GROUP BY
  cited_authorships_truncated

ORDER BY
  n_cited_works DESC
;


-- =====================================================================
-- 34. VALIDATION: FINAL PANEL SIZE
-- =====================================================================

SELECT

  COUNT(*) AS paper_country_rows,

  COUNT(DISTINCT work_id)
    AS unique_papers,

  SAFE_DIVIDE(
    COUNT(*),
    COUNT(DISTINCT work_id)
  ) AS target_countries_per_paper

FROM
  `foreign-phd.unitanalysis.broker2_paper_country50`
;


-- =====================================================================
-- 35. VALIDATION: ROBUSTNESS SAMPLE COUNTS BY COUNTRY
-- =====================================================================

SELECT

  degree_country_rank,
  target_degree_country,
  target_country_code,

  COUNTIF(
    has_matching_degree_author = 1
  ) AS n_exposed,

  COUNTIF(
    has_matching_degree_author = 1
    AND other_coauthor_current_target_country = 0
  ) AS n_exposed_no_active_target_country_coauthor,

  COUNTIF(
    has_matching_degree_author = 1
    AND current_team_us_only = 1
    AND citing_country_coverage_observed >= 0.80
  ) AS n_exposed_us_only_team_cov80,

  COUNTIF(
    has_matching_degree_author = 1
    AND matching_degree_corresponding = 1
  ) AS n_exposed_corresponding,

  COUNTIF(
    has_matching_degree_author = 1
    AND n_aarc_faculty = 1
  ) AS n_exposed_sole_aarc_faculty,

  AVG(reference_country_coverage)
    AS mean_reference_country_coverage,

  AVG(team_selfcitation_share)
    AS mean_team_selfcitation_share

FROM
  `foreign-phd.unitanalysis.broker2_paper_country50`

GROUP BY
  degree_country_rank,
  target_degree_country,
  target_country_code

ORDER BY
  degree_country_rank
;
