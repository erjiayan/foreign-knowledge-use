FROM
  `foreign-phd.unitanalysis.broker2_faculty_year_full`
;


-- =====================================================================
-- 8. AARC FACULTY-PAPER SPINE
--
-- Contemporaneous linkage:
-- publication year == AARC roster year.
-- =====================================================================

CREATE OR REPLACE TABLE
  `foreign-phd.unitanalysis.broker2_aarc_paper_authors` AS

SELECT DISTINCT

  w.id AS work_id,
  w.publication_year,

  fy.PersonId,
  fy.PersonName,
  fy.author_id,

  fy.InstitutionId,
  fy.InstitutionName,

  fy.DegreeYear,
  fy.DegreeInstitutionName,
  fy.DegreeInstitutionID,

  fy.RankTypeId,
  fy.FacultyTitle,

  fy.degree_country,
  fy.degree_country_code,

  fy.CCIHE_research2025,
  fy.CCIHE_research2025name,

  fy.confidence_tier,
  fy.match_score,
  fy.delta_score,

  a.author_position,
  a.is_corresponding,

  ARRAY_LENGTH(a.countries)
    AS oa_n_current_countries,

  a.countries
    AS oa_current_countries

FROM
  `subugoe-collaborative.openalex_walden.works` w

CROSS JOIN
  UNNEST(w.authorships) a

JOIN
  `foreign-phd.unitanalysis.broker2_faculty_year_core` fy

ON
  a.author.id = fy.author_id
  AND w.publication_year = fy.year

WHERE
  w.publication_year BETWEEN 2011 AND 2020
  AND a.author.id IS NOT NULL
;


-- =====================================================================
-- 9. PAPER-LEVEL AARC COMPOSITION
-- =====================================================================

CREATE OR REPLACE TABLE
  `foreign-phd.unitanalysis.broker2_paper_aarc_summary` AS

SELECT

  work_id,
  publication_year,

  COUNT(DISTINCT PersonId)
    AS n_aarc_faculty,

  COUNT(DISTINCT CASE
    WHEN degree_country = 'United States'
    THEN PersonId
  END) AS n_aarc_us_degree,

  COUNT(DISTINCT CASE
    WHEN degree_country != 'United States'
    THEN PersonId
  END) AS n_aarc_foreign_degree,

  COUNT(DISTINCT degree_country)
    AS n_aarc_degree_countries,

  COUNT(DISTINCT CASE
    WHEN degree_country != 'United States'
    THEN degree_country
  END) AS n_foreign_degree_countries,

  MAX(CASE
    WHEN degree_country != 'United States'
    THEN 1 ELSE 0
  END) AS has_foreign_degree_aarc,

  MAX(CASE
    WHEN degree_country = 'United States'
    THEN 1 ELSE 0
  END) AS has_us_degree_aarc,

  MAX(CASE
    WHEN degree_country != 'United States'
         AND is_corresponding
    THEN 1 ELSE 0
  END) AS has_foreign_degree_corresponding_aarc,

  MAX(CASE
    WHEN degree_country = 'United States'
         AND is_corresponding
    THEN 1 ELSE 0
  END) AS has_us_degree_corresponding_aarc

FROM
  `foreign-phd.unitanalysis.broker2_aarc_paper_authors`

GROUP BY
  work_id,
  publication_year
;


-- =====================================================================
-- 10. FOCAL PAPER MASTER
--
-- Store authorships_truncated diagnostically, but DO NOT filter on it.
-- =====================================================================

CREATE OR REPLACE TABLE
  `foreign-phd.unitanalysis.broker2_focal_papers` AS

SELECT

  w.id AS work_id,

  w.publication_year,
  w.publication_date,

  w.title,
  w.doi,
  w.language,

  w.authors_count,

  ARRAY_LENGTH(w.authorships)
    AS oa_authorship_records,

  SAFE_DIVIDE(
    ARRAY_LENGTH(w.authorships),
    w.authors_count
  ) AS authorship_record_coverage,

  w.authorships_truncated,

  w.institutions_distinct_count,
  w.countries_distinct_count,

  w.referenced_works_count,

  ARRAY_LENGTH(w.referenced_works)
    AS oa_reference_array_count,

  w.fwci,

  w.citation_normalized_percentile.value
    AS citation_percentile,

  w.citation_normalized_percentile.is_in_top_1_percent
    AS is_top1,

  w.citation_normalized_percentile.is_in_top_10_percent
    AS is_top10,

  w.primary_topic.id
    AS topic_id,

  w.primary_topic.display_name
    AS topic_name,

  w.primary_topic.subfield.id
    AS subfield_id,

  w.primary_topic.subfield.display_name
    AS subfield_name,

  w.primary_topic.field.id
    AS field_id,

  w.primary_topic.field.display_name
    AS field_name,

  w.primary_topic.domain.id
    AS domain_id,

  w.primary_topic.domain.display_name
    AS domain_name,

  w.primary_location.source.id
    AS source_id,

  w.primary_location.source.display_name
    AS source_name,

  s.n_aarc_faculty,
  s.n_aarc_us_degree,
  s.n_aarc_foreign_degree,

  s.n_aarc_degree_countries,
  s.n_foreign_degree_countries,

  s.has_foreign_degree_aarc,
  s.has_us_degree_aarc,

  s.has_foreign_degree_corresponding_aarc,
  s.has_us_degree_corresponding_aarc

FROM
  `subugoe-collaborative.openalex_walden.works` w

JOIN
  `foreign-phd.unitanalysis.broker2_paper_aarc_summary` s

ON
  w.id = s.work_id

WHERE
  w.publication_year BETWEEN 2011 AND 2020
;


-- =====================================================================
-- 11. CURRENT AFFILIATION COUNTRIES OF ALL CITING AUTHORS
-- =====================================================================

CREATE OR REPLACE TABLE
  `foreign-phd.unitanalysis.broker2_citing_author_countries` AS

SELECT DISTINCT

  w.id AS work_id,

  a.author.id AS author_id,

  country_code,

  a.author_position,
  a.is_corresponding,

  CASE
    WHEN ap.author_id IS NOT NULL
    THEN 1 ELSE 0
  END AS is_aarc_author,

  ap.degree_country AS aarc_degree_country,
  ap.degree_country_code AS aarc_degree_country_code

FROM
  `subugoe-collaborative.openalex_walden.works` w

JOIN
  `foreign-phd.unitanalysis.broker2_focal_papers` fp

ON
  w.id = fp.work_id

CROSS JOIN
  UNNEST(w.authorships) a

CROSS JOIN
  UNNEST(a.countries) country_code

LEFT JOIN
  `foreign-phd.unitanalysis.broker2_aarc_paper_authors` ap

ON
  w.id = ap.work_id
  AND a.author.id = ap.author_id

WHERE
  a.author.id IS NOT NULL
  AND country_code IS NOT NULL
  AND country_code != ''
;


-- =====================================================================
-- 12. CITING TEAM COUNTRY COVERAGE
--
-- Two coverage denominators are retained:
-- reported authors_count
-- observed authorship-record count
-- =====================================================================

CREATE OR REPLACE TABLE
  `foreign-phd.unitanalysis.broker2_citing_country_summary` AS

WITH mapped AS (

  SELECT

    w.id AS work_id,

    COUNT(DISTINCT a.author.id)
      AS n_authors_with_country,

    COUNT(DISTINCT country_code)
      AS n_current_countries,

    MAX(CASE
      WHEN country_code = 'US'
      THEN 1 ELSE 0
    END) AS has_us_current_affiliation,

    MAX(CASE
      WHEN country_code != 'US'
      THEN 1 ELSE 0
    END) AS has_nonus_current_affiliation

  FROM
    `subugoe-collaborative.openalex_walden.works` w

  JOIN
    `foreign-phd.unitanalysis.broker2_focal_papers` fp

  ON
    w.id = fp.work_id

  CROSS JOIN
    UNNEST(w.authorships) a

  CROSS JOIN
    UNNEST(a.countries) country_code

  WHERE
    a.author.id IS NOT NULL
    AND country_code IS NOT NULL
    AND country_code != ''

  GROUP BY
    w.id
)

SELECT

  fp.work_id,

  fp.authors_count,
  fp.oa_authorship_records,

  COALESCE(m.n_authors_with_country, 0)
    AS n_authors_with_country,

  SAFE_DIVIDE(
    COALESCE(m.n_authors_with_country, 0),
    fp.authors_count
  ) AS citing_country_coverage_reported,

  SAFE_DIVIDE(
    COALESCE(m.n_authors_with_country, 0),
    fp.oa_authorship_records
  ) AS citing_country_coverage_observed,

  COALESCE(m.n_current_countries, 0)
    AS n_current_countries,

  COALESCE(m.has_us_current_affiliation, 0)
    AS has_us_current_affiliation,

  COALESCE(m.has_nonus_current_affiliation, 0)
    AS has_nonus_current_affiliation,

  CASE
    WHEN m.n_current_countries = 1
         AND m.has_us_current_affiliation = 1
    THEN 1 ELSE 0
  END AS current_team_us_only

FROM
  `foreign-phd.unitanalysis.broker2_focal_papers` fp

LEFT JOIN mapped m
USING (work_id)
;


-- =====================================================================
-- 13. UNIQUE CITATION EDGES
-- =====================================================================

CREATE OR REPLACE TABLE
  `foreign-phd.unitanalysis.broker2_citation_edges_base` AS

SELECT DISTINCT

  w.id AS citing_work_id,

  w.publication_year AS citing_year,

  cited_work_id

FROM
  `subugoe-collaborative.openalex_walden.works` w

JOIN
  `foreign-phd.unitanalysis.broker2_focal_papers` fp

ON
  w.id = fp.work_id

CROSS JOIN
  UNNEST(w.referenced_works) cited_work_id

WHERE
  cited_work_id IS NOT NULL
;


-- =====================================================================
-- 14. CITED-WORK MASTER
--
-- No truncation filtering.
-- =====================================================================

CREATE OR REPLACE TABLE
  `foreign-phd.unitanalysis.broker2_cited_work_master` AS

WITH ids AS (

  SELECT DISTINCT cited_work_id

  FROM
    `foreign-phd.unitanalysis.broker2_citation_edges_base`
